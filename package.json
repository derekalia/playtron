{
  "name": "playtron",
  "version": "1.0.1",
  "description": "MCP server for Electron browser control via CDP - compatible with any MCP client",
  "main": "dist/index.js",
  "bin": {
    "playtron": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "lint": "eslint --ext .ts src/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "electron",
    "browser",
    "browser-automation",
    "playwright",
    "cdp",
    "chrome-devtools-protocol"
  ],
  "author": "Derek Alia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derekalia/playtron.git"
  },
  "homepage": "https://github.com/derekalia/playtron#readme",
  "bugs": {
    "url": "https://github.com/derekalia/playtron/issues"
  },
  "dependencies": {
    "eventsource": "^4.0.0",
    "fastmcp": "^3.9.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.54.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
